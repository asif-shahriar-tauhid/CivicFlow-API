model Department {
    id          String    @id @default(uuid())
    name        String    @unique
    description String?
    isActive    Boolean   @default(true)
    isArchived  Boolean   @default(false)
    archivedAt  DateTime?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    users             User[]
    serviceRequests   ServiceRequest[]
    routingRules      CategoryRoutingRule[]
    routingAuditsFrom RequestRoutingAudit[] @relation("RoutingAuditFromDepartment")
    routingAuditsTo   RequestRoutingAudit[] @relation("RoutingAuditToDepartment")

    @@index([isArchived, isActive], name: "idx_department_archived_active")
    @@map("departments")
}
