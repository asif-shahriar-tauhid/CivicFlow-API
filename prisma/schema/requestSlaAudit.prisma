model RequestSlaAudit {
    id            String   @id @default(uuid())
    requestId     String?
    categoryId    String?
    actorId       String?
    action        String
    previousValue Json?
    newValue      Json?
    createdAt     DateTime @default(now())

    request  ServiceRequest?  @relation(fields: [requestId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    category RequestCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    actor    User?            @relation("RequestSlaAuditActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

    @@index([requestId, createdAt], name: "idx_request_sla_audit_request_created")
    @@index([categoryId, createdAt], name: "idx_request_sla_audit_category_created")
    @@map("request_sla_audits")
}
