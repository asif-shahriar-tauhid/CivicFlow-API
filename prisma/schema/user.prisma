model User {
  id                  String                     @id @default(uuid())
  name                String
  email               String                     @unique
  password            String?
  googleId            String?                    @unique
  authProvider        AuthProvider               @default(CREDENTIAL)
  emailVerified       Boolean                    @default(false)
  role                Role                       @default(CITIZEN)
  status              UserStatus                 @default(ACTIVE)
  needPasswordChange  Boolean                    @default(false)
  imageUrl            String                     @default("")
  imagePublicId       String                     @default("")
  isDeleted           Boolean                    @default(false)
  deletedAt           DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  citizen             Citizen?
  createdRequests     ServiceRequest[]
  assignedRequests    ServiceRequest[]           @relation("ServiceRequestAssignee")
  assignmentsTo       RequestAssignment[]        @relation("AssignmentTarget")
  assignmentsBy       RequestAssignment[]        @relation("AssignmentActor")
  previousAssignments RequestAssignment[]        @relation("AssignmentPreviousAssignee")
  technicians         Technician[]
  departmentId        String?
  department          Department?                @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  routingAudits       RequestRoutingAudit[]
  attachments         RequestAttachment[]
  statusHistory       RequestStatusHistory[]     @relation("RequestStatusHistoryActor")
  investigationNotes  RequestInvestigationNote[] @relation("RequestInvestigationNoteActor")
  resolutions         RequestResolution[]        @relation("RequestResolutionActor")
  slaAudits           RequestSlaAudit[]          @relation("RequestSlaAuditActor")
  notifications       Notification[]
  auditLogs            AuditLog[]

  @@index([departmentId, role, status], name: "idx_user_department_role_status")
  @@map("users")
}
