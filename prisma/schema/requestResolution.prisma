model RequestResolution {
    id        String   @id @default(uuid())
    requestId String
    reason    String
    actorId   String
    createdAt DateTime @default(now())

    request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    actor   User           @relation("RequestResolutionActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    @@index([requestId, createdAt], name: "idx_request_resolution_request_created")
    @@map("request_resolutions")
}
