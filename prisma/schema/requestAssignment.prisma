model RequestAssignment {
    id                 String           @id @default(uuid())
    requestId          String
    assignedToId       String
    assignedById       String
    previousAssigneeId String?
    action             AssignmentAction
    createdAt          DateTime         @default(now())

    request          ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    assignedTo       User           @relation("AssignmentTarget", fields: [assignedToId], references: [id], onDelete: Restrict, onUpdate: Cascade)
    assignedBy       User           @relation("AssignmentActor", fields: [assignedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
    previousAssignee User?          @relation("AssignmentPreviousAssignee", fields: [previousAssigneeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

    @@index([requestId, createdAt], name: "idx_request_assignment_request_created")
    @@index([assignedToId, createdAt], name: "idx_request_assignment_assignee_created")
    @@map("request_assignments")
}
