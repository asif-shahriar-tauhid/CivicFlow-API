model RequestFeedback {
    id        String   @id @default(uuid())
    requestId String   @unique
    rating    Int
    comment   String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@index([rating, createdAt], name: "idx_request_feedback_rating_created")
    @@index([createdAt], name: "idx_request_feedback_created")
    @@map("request_feedback")
}
