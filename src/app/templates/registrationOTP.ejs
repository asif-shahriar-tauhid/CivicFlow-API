<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verify your CivicFlow account</title>
</head>
<body style="margin:0;background:#eef3f1;color:#18332d;font-family:Arial,Helvetica,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="padding:32px 16px;background:#eef3f1;">
    <tr><td align="center">
      <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="max-width:560px;background:#ffffff;border:1px solid #d5e2dd;">
        <tr><td style="padding:28px 36px;background:#145c4a;color:#ffffff;">
          <div style="font-size:24px;font-weight:700;"><%= APP_NAME %></div>
          <div style="margin-top:6px;font-size:13px;color:#d8eee7;">Your civic services, in one place</div>
        </td></tr>
        <tr><td style="padding:36px;">
          <p style="margin:0 0 12px;font-size:14px;color:#58716a;">ACCOUNT VERIFICATION</p>
          <h1 style="margin:0 0 16px;font-size:26px;color:#18332d;">Confirm your email address</h1>
          <p style="margin:0 0 24px;font-size:15px;line-height:1.7;color:#49625b;">Hello <strong><%= USER_NAME %></strong>, use the verification code below to activate your CivicFlow account and access municipal services.</p>
          <div style="padding:22px;text-align:center;background:#e8f4ef;border:1px solid #c7e3d8;">
            <div style="font-size:12px;text-transform:uppercase;letter-spacing:1px;color:#58716a;">Verification code</div>
            <div style="margin-top:10px;font-size:34px;font-weight:700;letter-spacing:8px;color:#145c4a;"><%= otpValue %></div>
            <div style="margin-top:10px;font-size:12px;color:#58716a;">Expires in <%= EXPIRY_MINUTES %> minutes</div>
          </div>
          <p style="margin:24px 0 0;font-size:13px;line-height:1.6;color:#70857f;">If you did not create a CivicFlow account, you can ignore this email. Never share this code with anyone.</p>
        </td></tr>
        <tr><td style="padding:20px 36px;background:#f6f9f8;font-size:12px;color:#70857f;">&copy; <%= CURRENT_YEAR %> <%= APP_NAME %>. Civic services made simpler.</td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
